---
const waNumber = "6285891609894";
const waMessage = encodeURIComponent("Halo Rasi Dental Studio, saya mau tanya konsultasi & jadwal perawatan gigi Behel/Veneer.");
const waUrl = `https://wa.me/${waNumber}?text=${waMessage}`;
---

<section id="reservasi" class="py-14 sm:py-20 bg-[#FAF8F5] border-t border-b border-[#E5ECE8]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto mb-8 sm:mb-10">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] mb-3">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span>Reservasi Langsung via WhatsApp</span>
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1A2421] tracking-tight leading-tight">
        Siap Konsultasi <span class="italic font-normal text-[#0D4736]">Gigi Estetik?</span>
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-[#1A2421] font-medium leading-relaxed">
        Hubungi tim admin medis Rasi Dental Studio untuk pencocokan jadwal dokter, estimasi biaya rincian awal, dan memilih jam praktek.
      </p>
    </div>

    <!-- Direct WhatsApp CTA Box -->
    <div class="max-w-xl mx-auto bg-white p-7 sm:p-9 rounded-3xl border border-[#E5ECE8] shadow-sm space-y-6">
      <div class="p-4 rounded-2xl bg-[#FAF8F5] border border-[#EBE6DF] text-left text-xs font-semibold text-[#1A2421] space-y-2">
        <div class="flex items-center gap-2 text-[#0D4736] font-bold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Praktek Resmi Dokgim Bandung</span>
        </div>
        <p class="text-[#1A2421] font-medium">Jl. Cihampelas No. 88, Bandung • Selasa – Minggu (11.00 – 21.00 WIB)</p>
      </div>

      <!-- Action Button to WhatsApp -->
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-sumber="cta-penutup-booking"
        aria-label="Chat WhatsApp Admin Rasi Dental Studio"
        class="w-full py-4 px-6 rounded-xl text-sm sm:text-base font-bold text-white bg-[#0D4736] hover:bg-[#072E23] transition-all shadow-md flex items-center justify-center gap-2.5 cursor-pointer"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>Chat WhatsApp Sekarang</span>
      </a>

      <p class="text-[11px] text-[#1A2421] text-center font-semibold flex items-center justify-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-[#0D4736]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span>Tanpa form rumit. Langsung terhubung ke WhatsApp Admin Rasi Studio.</span>
      </p>
    </div>

  </div>
</section>
