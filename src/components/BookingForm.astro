---
const waNumber = "6285891609894";
---

<section id="reservasi" class="py-14 sm:py-24 bg-[#FAF8F5] border-t border-b border-[#E5ECE8]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] mb-3">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span>Reservasi Online Praktis</span>
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1A2421] tracking-tight leading-tight">
        Reservasi Jadwal <span class="italic font-normal text-[#0D4736]">Konsultasi Gigi</span>
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-[#1A2421] font-medium leading-relaxed">
        Lengkapi formulir di bawah ini. Setelah diisi, konfirmasi reservasi akan terhubung otomatis ke WhatsApp admin kami.
      </p>
    </div>

    <!-- Booking Form Card -->
    <div class="max-w-2xl mx-auto bg-white p-6 sm:p-10 rounded-3xl border border-[#E5ECE8] shadow-sm">
      <form id="booking-form" class="space-y-6">
        
        <!-- Field 1: Nama Lengkap -->
        <div>
          <label for="booking-nama" class="block text-xs uppercase font-bold text-[#1A2421] tracking-wider mb-2">
            Nama Lengkap <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="booking-nama"
            required
            placeholder="Contoh: Nabila Rizki"
            class="w-full px-4 py-3.5 rounded-xl border border-[#D8E0DC] text-sm font-medium text-[#1A2421] focus:outline-none focus:ring-2 focus:ring-[#0D4736] focus:border-[#0D4736] transition-all placeholder:text-[#667A71]"
          />
        </div>

        <!-- Field 2: Nomor WhatsApp -->
        <div>
          <label for="booking-wa" class="block text-xs uppercase font-bold text-[#1A2421] tracking-wider mb-2">
            Nomor WhatsApp / HP <span class="text-red-500">*</span>
          </label>
          <input
            type="tel"
            id="booking-wa"
            required
            placeholder="Contoh: 081234567890"
            class="w-full px-4 py-3.5 rounded-xl border border-[#D8E0DC] text-sm font-medium text-[#1A2421] focus:outline-none focus:ring-2 focus:ring-[#0D4736] focus:border-[#0D4736] transition-all placeholder:text-[#667A71]"
          />
        </div>

        <!-- Grid 2 Columns: Perawatan & Dokter -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- Field 3: Perawatan -->
          <div>
            <label for="booking-perawatan" class="block text-xs uppercase font-bold text-[#1A2421] tracking-wider mb-2">
              Jenis Perawatan <span class="text-red-500">*</span>
            </label>
            <select
              id="booking-perawatan"
              required
              class="w-full px-4 py-3.5 rounded-xl border border-[#D8E0DC] text-sm font-semibold text-[#1A2421] bg-white focus:outline-none focus:ring-2 focus:ring-[#0D4736] focus:border-[#0D4736] transition-all cursor-pointer"
            >
              <option value="Paket Behel Ortodonti">Paket Behel Ortodonti</option>
              <option value="Aesthetic Veneer Gigi">Aesthetic Veneer Gigi</option>
              <option value="Teeth Whitening & Scaling">Teeth Whitening &amp; Scaling</option>
              <option value="Konsultasi & Check-up Umum">Konsultasi &amp; Check-up Umum</option>
              <option value="Perawatan Lainnya">Perawatan Lainnya</option>
            </select>
          </div>

          <!-- Field 4: Dokter -->
          <div>
            <label for="booking-dokter" class="block text-xs uppercase font-bold text-[#1A2421] tracking-wider mb-2">
              Pilihan Dokter
            </label>
            <select
              id="booking-dokter"
              class="w-full px-4 py-3.5 rounded-xl border border-[#D8E0DC] text-sm font-semibold text-[#1A2421] bg-white focus:outline-none focus:ring-2 focus:ring-[#0D4736] focus:border-[#0D4736] transition-all cursor-pointer"
            >
              <option value="Dokter Mana Saja (Rekomendasi)">Bebas / Dokter Mana Saja</option>
              <option value="drg. Kirana Ayu, Sp.Ort (Spesialis Behel)">drg. Kirana, Sp.Ort (Behel)</option>
              <option value="drg. Bimo Prasetya (Estetika & Restorasi)">drg. Bimo Prasetya (Veneer/Whitening)</option>
            </select>
          </div>
        </div>

        <!-- Grid 2 Columns: Tanggal & Waktu -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- Field 5: Tanggal -->
          <div>
            <label for="booking-tanggal" class="block text-xs uppercase font-bold text-[#1A2421] tracking-wider mb-2">
              Rencana Tanggal
            </label>
            <input
              type="date"
              id="booking-tanggal"
              class="w-full px-4 py-3.5 rounded-xl border border-[#D8E0DC] text-sm font-medium text-[#1A2421] bg-white focus:outline-none focus:ring-2 focus:ring-[#0D4736] focus:border-[#0D4736] transition-all cursor-pointer"
            />
          </div>

          <!-- Field 6: Jam/Waktu -->
          <div>
            <label for="booking-waktu" class="block text-xs uppercase font-bold text-[#1A2421] tracking-wider mb-2">
              Pilihan Jam
            </label>
            <select
              id="booking-waktu"
              class="w-full px-4 py-3.5 rounded-xl border border-[#D8E0DC] text-sm font-semibold text-[#1A2421] bg-white focus:outline-none focus:ring-2 focus:ring-[#0D4736] focus:border-[#0D4736] transition-all cursor-pointer"
            >
              <option value="Siang (11.00 – 15.00 WIB)">Sesi Siang (11.00 – 15.00 WIB)</option>
              <option value="Sore / Malam (15.00 – 21.00 WIB)">Sesi Sore/Malam (15.00 – 21.00 WIB)</option>
            </select>
          </div>
        </div>

        <!-- Field 7: Catatan Tambahan -->
        <div>
          <label for="booking-catatan" class="block text-xs uppercase font-bold text-[#1A2421] tracking-wider mb-2">
            Catatan / Keluhan Gigi
          </label>
          <textarea
            id="booking-catatan"
            rows="3"
            placeholder="Contoh: Ingin konsultasi behel rahang atas & estimasi biaya cicilan per kontrol."
            class="w-full px-4 py-3.5 rounded-xl border border-[#D8E0DC] text-sm font-medium text-[#1A2421] focus:outline-none focus:ring-2 focus:ring-[#0D4736] focus:border-[#0D4736] transition-all placeholder:text-[#667A71]"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          data-sumber="cta-booking-form"
          aria-label="Kirim Formulir Reservasi ke WhatsApp Admin"
          class="w-full py-4 px-6 rounded-xl text-sm sm:text-base font-bold text-white bg-[#0D4736] hover:bg-[#072E23] active:scale-[0.99] transition-all shadow-md flex items-center justify-center gap-2.5 cursor-pointer"
        >
          <span>Kirim &amp; Hubungkan ke WhatsApp Admin</span>
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </button>

        <p class="text-[11px] text-[#1A2421] text-center font-semibold flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#0D4736]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span>Data Anda terjaga. Pesan terhubung langsung ke WhatsApp Resmi Rasi Dental Studio.</span>
        </p>

      </form>
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const bookingForm = document.getElementById('booking-form');
    if (bookingForm) {
      bookingForm.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const nama = document.getElementById('booking-nama')?.value.trim() || '';
        const wa = document.getElementById('booking-wa')?.value.trim() || '';
        const perawatan = document.getElementById('booking-perawatan')?.value || '';
        const dokter = document.getElementById('booking-dokter')?.value || '';
        const tanggal = document.getElementById('booking-tanggal')?.value || '';
        const waktu = document.getElementById('booking-waktu')?.value || '';
        const catatan = document.getElementById('booking-catatan')?.value.trim() || '';

        let text = `Halo Rasi Dental Studio, saya ingin reservasi jadwal konsultasi:\n\n`;
        text += `• Nama: ${nama}\n`;
        if (wa) text += `• No. HP/WA: ${wa}\n`;
        text += `• Perawatan: ${perawatan}\n`;
        text += `• Pilihan Dokter: ${dokter}\n`;
        if (tanggal) text += `• Rencana Tanggal: ${tanggal}\n`;
        if (waktu) text += `• Pilihan Sesi: ${waktu}\n`;
        if (catatan) text += `• Catatan/Keluhan: ${catatan}\n`;

        const targetWaNumber = "6285891609894";
        const waUrl = `https://wa.me/${targetWaNumber}?text=${encodeURIComponent(text)}`;
        
        window.open(waUrl, '_blank');
      });
    }
  });
</script>
