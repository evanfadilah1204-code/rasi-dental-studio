---
const steps = [
  {
    step: "01",
    title: "Reservasi Online",
    desc: "Isi formulir reservasi atau hubungi admin via WhatsApp untuk memilih jadwal konsultasi tanpa harus mengantre lama."
  },
  {
    step: "02",
    title: "Konsultasi & Biaya Transparan",
    desc: "Dokter akan mengecek kondisi gigi dan menjelaskan seluruh rincian estimasi biaya secara utuh sebelum tindakan dimulai."
  },
  {
    step: "03",
    title: "Penanganan Medik Lembut",
    desc: "Tindakan dilakukan oleh dokter spesialis berpengalaman menggunakan teknik minimal invasif dan alat presisi modern."
  },
  {
    step: "04",
    title: "Care Kit & Kontrol Berkala",
    desc: "Selesai perawatan dilengkapi panduan perawatan di rumah serta jadwal penyesuaian kontrol secara berkala."
  }
];
---

<section id="alur" class="py-14 sm:py-20 bg-white border-t border-[#E5ECE8]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] mb-3">
        Alur Pasien Studio
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1A2421] tracking-tight">
        4 Langkah Mudah <span class="italic font-normal text-[#0D4736]">Kunjungan Perawatan</span>
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-[#52665E] font-normal leading-relaxed">
        Proses pelayanan terstruktur, praktis, dan transparan dari awal hingga akhir kunjungan Anda.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {steps.map((item) => (
        <div class="p-6 rounded-3xl bg-[#FAF8F5] border border-[#E5ECE8] relative flex flex-col justify-between space-y-4 hover:border-[#CBD9D2] transition-all">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-[#0D4736] text-white font-serif font-bold text-sm flex items-center justify-center mb-5 shadow-xs">
              {item.step}
            </div>

            <h3 class="font-serif font-bold text-base text-[#1A2421] mb-2">{item.title}</h3>
            <p class="text-xs text-[#52665E] font-normal leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

