---
const waNumber = "6285891609894";

const doctors = [
  {
    name: "drg. Kirana Ayu, Sp.Ort",
    title: "Spesialis Ortodonti (Behel)",
    experience: "Pengalaman Praktik 12+ Tahun",
    str: "STR: 31.2.1.100.3.18.123456",
    alumni: "Alumni Fakultas Kedokteran Gigi Universitas Padjadjaran (UNPAD)",
    specialties: ["Behel Metal & Ceramic", "Sapphire Aesthetic Braces", "Alignment Gigi Kompleks"],
    quote: "Kunci dari senyum estetik yang bertahan lama adalah perencanaan ortodonti presisi yang memperhatikan kesehatan struktur rahang.",
    badge: "Spesialis Ortodonti",
    badgeColor: "forest",
    image: "/images/drg_kirana.jpg"
  },
  {
    name: "drg. Bimo Prasetya",
    title: "Dokter Gigi Restorasi & Estetika",
    experience: "Pengalaman Praktik 8+ Tahun",
    str: "STR: 31.1.1.100.2.19.654321",
    alumni: "Alumni Fakultas Kedokteran Gigi Universitas Indonesia (UI)",
    specialties: ["Direct Composite Veneer", "E-Max Porcelain Veneer", "Teeth Whitening Express"],
    quote: "Senyum estetik ideal tidak perlu mengorbankan struktur asli gigi. Kami selalu menerapkan teknik penanganan minimal invasif.",
    badge: "Estetika & Restorasi",
    badgeColor: "amber",
    image: "/images/drg_bimo.jpg"
  }
];
---

<section id="dokter" class="relative py-14 sm:py-20 bg-[#FAF8F5] border-t border-[#E5ECE8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] mb-3">
        Tim Medis Berlisensi
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1A2421] tracking-tight leading-tight">
        Dokter Gigi &amp; <span class="italic font-normal text-[#0D4736]">Spesialis Ortodonti</span>
      </h2>
      <p class="mt-3 text-xs sm:text-base text-[#52665E] font-normal leading-relaxed">
        Seluruh tindakan medis ditangani secara personal oleh dokter gigi berizin resmi SIP Dinkes yang komunikatif &amp; ramah.
      </p>
    </div>

    <!-- Doctors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {doctors.map((doc) => {
        const message = encodeURIComponent(`Halo Rasi Dental Studio, saya ingin membuat janji konsultasi dengan ${doc.name}.`);
        const waUrl = `https://wa.me/${waNumber}?text=${message}`;

        return (
          <div class="rounded-3xl p-6 sm:p-8 bg-white border border-[#E5ECE8] shadow-2xs flex flex-col justify-between space-y-5 hover:border-[#CBD9D2] transition-all">
            <div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-3 border-b border-[#F0F4F2]">
                <span class={`px-3 py-0.5 rounded-full text-[11px] font-bold w-fit ${doc.badgeColor === 'forest' ? 'bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2]' : 'bg-[#FEF3C7] text-[#92400E] border border-[#FDE68A]'}`}>
                  {doc.badge}
                </span>
                <div class="text-[11px] text-[#667A71] font-mono font-medium flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#0D4736]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  <span>SIP Dinkes Resmi</span>
                </div>
              </div>

              <div class="flex items-center gap-4 mb-4">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border-2 border-[#CBD9D2] shrink-0 shadow-sm relative group">
                  <img 
                    src={doc.image} 
                    alt={`Foto ${doc.name}`} 
                    width="160" 
                    height="160"
                    loading="lazy" 
                    decoding="async" 
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300" 
                  />
                </div>
                <div>
                  <h3 class="font-serif text-lg sm:text-xl font-bold text-[#1A2421]">{doc.name}</h3>
                  <p class="text-xs font-semibold text-[#0D4736]">{doc.title}</p>
                  <p class="text-[11px] text-[#667A71] font-normal">{doc.experience}</p>
                </div>
              </div>

              <div class="p-3.5 rounded-xl bg-[#FAF8F5] border border-[#EBE6DF] mb-4 text-xs text-[#2A3832] font-medium flex items-center gap-2">
                <svg class="w-4 h-4 text-[#0D4736] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                </svg>
                <span>{doc.alumni}</span>
              </div>

              <blockquote class="italic text-xs text-[#2F443A] border-l-2 border-[#0D4736] pl-3 mb-4 leading-relaxed font-medium">
                "{doc.quote}"
              </blockquote>

              <div class="mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-[#1F2E28] block mb-2">Fokus Tindakan:</span>
                <div class="flex flex-wrap gap-1.5">
                  {doc.specialties.map((spec) => (
                    <span class="px-2.5 py-1 rounded-lg bg-[#FAF8F5] border border-[#E5ECE8] text-[11px] font-semibold text-[#1A2421]">
                      {spec}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Jadwalkan Konsultasi dengan ${doc.name}`}
              class="w-full py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold text-center text-white bg-[#0D4736] hover:bg-[#072E23] transition-colors shadow-xs flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.67-1.616-.919-2.213-.242-.58-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span>Jadwalkan Konsultasi</span>
            </a>
          </div>
        );
      })}
    </div>



  </div>
</section>



