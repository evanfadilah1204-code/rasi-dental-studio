---
const faqs = [
  {
    q: "Bagaimana jika saya khawatir atau takut merasa nyeri saat tindakan gigi?",
    a: "Tidak perlu khawatir. Setiap prosedur di Rasi Dental Studio dilakukan secara perlahan oleh dokter berpengalaman menggunakan teknik penanganan lembut (gentle care), anestesi presisi, dan peralatan modern untuk meminimalkan rasa tidak nyaman selama maupun sesudah tindakan."
  },
  {
    q: "Apakah estimasi biaya di Rasi Dental Studio benar-benar 100% transparan?",
    a: "Ya, betul. Sebelum tindakan medis atau pemasangan behel/veneer dimulai, dokter kami akan mendiskusikan seluruh rincian estimasi biaya secara utuh. Tidak ada biaya tersembunyi atau biaya pendaftaran mendadak saat pembayaran."
  },
  {
    q: "Apakah pembayaran paket behel ortodonti bisa dicicil?",
    a: "Bisa. Pembayaran paket behel dapat dilakukan dengan skema pembayaran bertahap (DP saat pencetakan &amp; pemasangan awal, lalu sisa biaya dapat dicicil per jadwal kedatangan kontrol bulanan)."
  },
  {
    q: "Bagaimana jika saya canggung atau ragu konsultasi karena kondisi gigi kurang rapi?",
    a: "Suasana Rasi Dental Studio didesain hangat dan nyaman layaknya café dengan tim dokter medis yang empatik &amp; ramah. Kami menyambut dan mendengarkan keluhan Anda tanpa pernah menghakimi kondisi awal gigi."
  },
  {
    q: "Bagaimana cara reservasi jadwal konsultasi agar tidak perlu mengantre?",
    a: "Anda cukup mengisi formulir reservasi di website ini untuk terhubung langsung dengan admin WhatsApp kami. Admin akan mencocokkan jadwal dokter dan jam yang paling sesuai untuk Anda."
  },
  {
    q: "Apakah lokasi studio mudah diakses dan memiliki tempat parkir?",
    a: "Sangat mudah. Rasi Dental Studio berlokasi di Jl. Cihampelas No. 88, Bandung (dekat Cihampelas Walk / Ciwalk). Tersedia area parkir kendaraan mobil &amp; motor yang aman."
  }
];
---

<section id="faq" class="relative py-14 sm:py-20 bg-white border-t border-[#E5ECE8]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] mb-3">
        Tanya Jawab Pasien
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1A2421] tracking-tight leading-tight">
        Pertanyaan Umum <span class="italic font-normal text-[#0D4736]">Pasien Rasi</span>
      </h2>
      <p class="mt-3 text-xs sm:text-base text-[#52665E] font-normal leading-relaxed">
        Jawaban seputar prosedur behel ortodonti, veneer gigi estetik, dan transparansi biaya perawatan.
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="rounded-2xl bg-[#FAF8F5] border border-[#E5ECE8] overflow-hidden group hover:border-[#CBD9D2] transition-all">
          <summary class="p-5 flex items-center justify-between gap-4 cursor-pointer font-serif font-bold text-base sm:text-lg text-[#1A2421] select-none focus:outline-none">
            <span>{faq.q}</span>
            <span class="w-8 h-8 rounded-xl bg-white border border-[#E5ECE8] flex items-center justify-center text-[#0D4736] shrink-0 group-open:rotate-180 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-xs sm:text-sm text-[#52665E] font-normal leading-relaxed border-t border-[#EBE6DF]">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>


