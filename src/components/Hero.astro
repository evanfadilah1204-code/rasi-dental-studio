---
const waNumber = "6285891609894";
const waMessage = encodeURIComponent("Halo Rasi Dental Studio, saya mau tanya rincian konsultasi Behel & Veneer.");
const waUrl = `https://wa.me/${waNumber}?text=${waMessage}`;
---

<section class="py-12 sm:py-20 bg-[#FAF8F5] border-b border-[#E5ECE8] overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copywriting & CTAs -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Verified Dinkes Permit Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] shadow-2xs">
          <svg class="w-4 h-4 text-[#0D4736]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="font-bold">Izin Operasional Dinkes Kota Bandung</span>
          <span class="text-[#0D4736]">•</span>
          <span>Praktik Resmi Dokgim</span>
        </div>

        <!-- Main Headline with Editorial Serif Accent -->
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-[#1A2421] tracking-tight leading-[1.15]">
          Klinik Gigi Spesialis Behel &amp; Veneer di <span class="italic text-[#0D4736] font-normal">Bandung</span> dengan Transparansi Biaya 100%
        </h1>

        <!-- Short Description -->
        <p class="text-sm sm:text-base text-[#1A2421] font-medium max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Studio perawatan gigi estetik modern di area <strong class="text-[#1A2421] font-bold">Cihampelas, Bandung</strong>. Ditangani langsung Dokter Spesialis Ortodonti &amp; Estetika dengan rincian biaya yang disampaikan 100% transparan sebelum tindakan.
        </p>

        <!-- Action Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5">
          <a
            href="#reservasi"
            aria-label="Reservasi Online Sekarang"
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-sm text-white bg-[#0D4736] hover:bg-[#072E23] transition-all shadow-sm text-center flex items-center justify-center gap-2.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Reservasi Online</span>
          </a>

          <a
            href="#biaya"
            aria-label="Lihat Estimasi Biaya Perawatan"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-sm text-[#1A2421] bg-white hover:bg-[#F3F7F5] border border-[#CBD9D2] transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Estimasi Biaya Perawatan</span>
            <svg class="w-4 h-4 text-[#1A2421]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Clean Cost Preview Card -->
        <div class="pt-3 max-w-2xl mx-auto lg:mx-0">
          <div class="p-4 sm:p-5 rounded-2xl bg-white border border-[#E5ECE8] shadow-2xs text-left space-y-3">
            <div class="flex items-center justify-between border-b border-[#F0F4F2] pb-2.5">
              <span class="text-xs font-bold uppercase tracking-wider text-[#1A2421]">Perkiraan Biaya Perawatan Studio:</span>
              <span class="text-xs font-bold text-[#0D4736] bg-[#EAF2EE] px-2.5 py-0.5 rounded-md">Transparan di Awal</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs font-semibold text-[#1A2421]">
              <div class="p-3 rounded-xl bg-[#FAF8F5] border border-[#EBE6DF]">
                <span class="text-[11px] text-[#1A2421] block font-semibold">Behel Aesthetic</span>
                <span class="text-[#0D4736] font-bold text-sm block mt-0.5">Mulai 4.500.000</span>
              </div>

              <div class="p-3 rounded-xl bg-[#FAF8F5] border border-[#EBE6DF]">
                <span class="text-[11px] text-[#1A2421] block font-semibold">Veneer Gigi</span>
                <span class="text-[#78350F] font-bold text-sm block mt-0.5">Mulai 750.000</span>
              </div>

              <div class="p-3 rounded-xl bg-[#FAF8F5] border border-[#EBE6DF]">
                <span class="text-[11px] text-[#1A2421] block font-semibold">Whitening &amp; Scaling</span>
                <span class="text-[#065F46] font-bold text-sm block mt-0.5">Mulai 350.000</span>
              </div>
            </div>

            <div class="flex items-center justify-center gap-2 pt-1 text-[11px] text-[#1A2421] font-bold">
              <svg class="w-3.5 h-3.5 text-[#0D4736]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Jam Operasional: Selasa – Minggu (11.00 – 21.00 WIB)</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Studio Interior Image -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl overflow-hidden border border-[#D8E0DC] shadow-lg bg-white aspect-[4/3] sm:aspect-[4/3] lg:aspect-[5/4]">
          <picture>
            <source srcset="/images/hero_dental_studio.webp" type="image/webp" />
            <img
              src="/images/hero_dental_studio.jpg"
              alt="Interior Rasi Dental Studio Bandung"
              width="600"
              height="480"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </picture>
          
          <!-- Authentic Studio Caption Tag -->
          <div class="absolute bottom-4 left-4 right-4 p-3.5 rounded-xl bg-[#1A2421]/90 backdrop-blur-md border border-white/10 text-white shadow-md flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#0D4736] flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <div>
              <span class="font-bold text-xs block text-white">Suasana Studio Café Estetik</span>
              <span class="text-[11px] text-[#EAF2EE] block font-medium">Ruang tunggu tenang ber-AC, ramah &amp; nyaman di Bandung</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

