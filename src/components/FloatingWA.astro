---
const waNumber = "6285891609894";
const waMessage = encodeURIComponent("Halo Rasi Dental Studio, saya mau tanya rincian konsultasi & jadwal perawatan gigi.");
const waUrl = `https://wa.me/${waNumber}?text=${waMessage}`;
---

<!-- Fixed Floating WhatsApp CTA Button -->
<aside class="fixed bottom-6 right-6 z-50">
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Konsultasi WhatsApp Rasi Dental Studio"
    class="group relative flex items-center justify-center gap-2.5 px-4.5 py-3 rounded-full bg-[#0D4736] text-white font-bold text-xs shadow-lg hover:bg-[#072E23] active:scale-95 transition-all duration-300 border border-white/20"
  >
    <!-- Pulse Ring Animation -->
    <span class="absolute -inset-0.5 rounded-full bg-[#0D4736] opacity-30 group-hover:opacity-60 blur-xs animate-pulse"></span>
    
    <img src="/images/whatsapp_logo.svg" width="24" height="24" class="relative z-10 w-6 h-6 shrink-0" alt="WhatsApp Logo" />
    <span class="relative z-10">Chat Admin Studio</span>
  </a>
</aside>


