---
const objections = [
  {
    iconType: "gentle",
    title: "Khawatir Nyeri atau Sakit?",
    tag: "Teknik Penanganan Lembut",
    desc: "Setiap prosedur dilakukan secara perlahan oleh dokter berpengalaman menggunakan peralatan modern presisi tinggi untuk meminimalkan rasa tidak nyaman."
  },
  {
    iconType: "transparent",
    title: "Takut Biaya Tersembunyi?",
    tag: "Transparan Sebelum Tindakan",
    desc: "Perincian lengkap estimasi perawatan dijelaskan secara transparan di awal. Tanpa biaya pendaftaran kejutan, dan paket behel dapat dicicil per kontrol."
  },
  {
    iconType: "empathy",
    title: "Canggung atau Malu Konsultasi?",
    tag: "Pendekatan Ramah & Empatik",
    desc: "Suasana studio yang hangat seperti café dengan tim medis yang komunikatif. Kami menyambut dan mendengarkan keluhan Anda tanpa pernah menghakimi kondisi awal gigi."
  }
];
---

<section id="keberatan" class="py-14 sm:py-20 bg-[#FAF8F5] border-t border-[#E5ECE8]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] mb-3">
        Kenyamanan Pasien Utama
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1A2421] tracking-tight">
        Perawatan Gigi Tanpa <span class="italic font-normal text-[#0D4736]">Ragu &amp; Rasa Cemas</span>
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-[#52665E] font-normal leading-relaxed">
        Jawaban atas berbagai kekhawatiran yang sering dirasakan calon pasien sebelum melakukan reservasi konsultasi gigi.
      </p>
    </div>

    <!-- Objections Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {objections.map((item) => (
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-[#E5ECE8] shadow-2xs hover:border-[#CBD9D2] transition-all flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="w-11 h-11 rounded-2xl bg-[#EAF2EE] text-[#0D4736] flex items-center justify-center shrink-0">
                {item.iconType === 'gentle' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                )}
                {item.iconType === 'transparent' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {item.iconType === 'empathy' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
              </div>
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-[#FAF8F5] text-[#3D4F46] border border-[#E5ECE8]">
                {item.tag}
              </span>
            </div>

            <h3 class="font-serif font-bold text-lg text-[#1A2421] mb-2">{item.title}</h3>
            <p class="text-xs sm:text-sm text-[#52665E] font-normal leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

