---
const services = [
  {
    title: "Behel Ortodonti (Braces)",
    badge: "Ortodonti Presisi",
    desc: "Perataan susunan gigi rahang atas dan bawah menggunakan braket Metal & Sapphire Aesthetic presisi oleh Dokter Spesialis Ortodonti.",
    features: ["Behel Metal & Ceramic", "Sapphire Aesthetic Braces", "Cicilan Per Kedatangan Kontrol"]
  },
  {
    title: "Direct & Indirect Veneer",
    badge: "Estetika Gigi",
    desc: "Koreksi warna, bentuk, dan celah gigi depan instan untuk hasil senyum simetris natural yang tahan lama.",
    features: ["Direct Composite Veneer", "Indirect Porcelain E-Max", "Desain Senyum Simetris Natural"]
  },
  {
    title: "Teeth Whitening Express",
    badge: "Pemutihan Gigi",
    desc: "Pemutihan gigi instan 45 menit aman dikombinasikan dengan pembersihan karang gigi ultrasonik.",
    features: ["Hasil Cerah Instan", "Scaling Pembersihan Karang", "Perlindungan Enamel & Gusi"]
  },
  {
    title: "Konsultasi & Check-up General",
    badge: "Pemeriksaan Medis",
    desc: "Pemeriksaan kesehatan gigi menyeluruh dan analisis estetik senyum lengkap dengan penjelasan estimasi biaya di awal.",
    features: ["Pemeriksaan Kamera Intraoral", "Rencana Perawatan Personal", "Estimasi Biaya 100% Transparan"]
  }
];
---

<section id="layanan" class="py-14 sm:py-20 bg-white border-t border-[#E5ECE8]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] mb-3">
        Pelayanan Medik Estetik
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1A2421] tracking-tight">
        Layanan Spesialis <span class="italic font-normal text-[#0D4736]">Rasi Dental Studio</span>
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-[#52665E] font-normal leading-relaxed">
        Pilihan perawatan gigi estetik &amp; kesehatan gigi modern untuk kebutuhan senyum percaya diri Anda.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {services.map((item) => (
        <div class="p-6 sm:p-8 rounded-3xl bg-[#FAF8F5] border border-[#E5ECE8] shadow-2xs hover:border-[#CBD9D2] transition-all flex flex-col justify-between space-y-5">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-white text-[#0D4736] border border-[#CBD9D2]">
                {item.badge}
              </span>
            </div>

            <h3 class="font-serif font-bold text-xl text-[#1A2421] mb-2">{item.title}</h3>
            <p class="text-xs sm:text-sm text-[#52665E] font-normal leading-relaxed mb-5">{item.desc}</p>

            <ul class="space-y-2.5 text-xs text-[#2A3832] font-medium">
              {item.features.map((feat) => (
                <li class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-[#0D4736] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 border-t border-[#E5ECE8]">
            <a
              href="#reservasi"
              class="inline-flex items-center gap-2 text-xs font-bold text-[#0D4736] hover:text-[#072E23] transition-colors"
            >
              <span>Reservasi Layanan Ini</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

