---
const waNumber = "6285891609894";
const waMessage = encodeURIComponent("Halo Rasi Dental Studio, saya mau tanya konsultasi Behel & Veneer.");
const waUrl = `https://wa.me/${waNumber}?text=${waMessage}`;
---

<header class="sticky top-0 z-50 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-[#E5ECE8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" aria-label="Rasi Dental Studio Beranda" class="flex items-center gap-3 group">
      <img src="/images/logo_rasi_dental.svg" width="40" height="40" class="w-10 h-10 rounded-xl shadow-xs transition-transform group-hover:scale-105 shrink-0" alt="Rasi Dental Studio Logo" />
      <div>
        <span class="font-serif font-bold text-lg text-[#1A2421] block leading-tight tracking-tight">Rasi Dental Studio</span>
        <span class="text-[11px] text-[#1A2421] font-semibold tracking-wide uppercase block">Dental &amp; Aesthetic • Bandung</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 text-xs font-bold uppercase tracking-wider text-[#1A2421]">
      <a href="#biaya" class="hover:text-[#0D4736] transition-colors py-1">Harga &amp; Paket</a>
      <a href="#layanan" class="hover:text-[#0D4736] transition-colors py-1">Layanan</a>
      <a href="#dokter" class="hover:text-[#0D4736] transition-colors py-1">Dokter Gigi</a>
      <a href="#lokasi" class="hover:text-[#0D4736] transition-colors py-1">Lokasi &amp; Jam</a>
      <a href="#faq" class="hover:text-[#0D4736] transition-colors py-1">FAQ</a>
    </nav>

    <!-- Action Button -->
    <div class="flex items-center gap-2.5">
      <a 
        href="#reservasi"
        aria-label="Reservasi Jadwal Konsultasi Gigi"
        class="px-4 sm:px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-[#0D4736] hover:bg-[#072E23] transition-all shadow-xs flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>Reservasi Jadwal</span>
      </a>

      <!-- Mobile Menu Toggle -->
      <details class="md:hidden relative">
        <summary aria-label="Buka Menu Navigasi" class="p-2 rounded-xl bg-white border border-[#E5ECE8] text-[#1A2421] cursor-pointer list-none shadow-xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </summary>
        <div class="absolute right-0 top-12 w-52 p-2 rounded-2xl bg-white border border-[#E5ECE8] shadow-xl flex flex-col gap-1 text-xs font-semibold z-50">
          <a href="#reservasi" class="px-3.5 py-2.5 rounded-xl hover:bg-[#EAF2EE] text-[#0D4736] font-bold flex items-center gap-2">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Reservasi Jadwal
          </a>
          <a href="#biaya" class="px-3.5 py-2 rounded-xl hover:bg-[#FAF8F5] text-[#1A2421]">Estimasi Paket Harga</a>
          <a href="#layanan" class="px-3.5 py-2 rounded-xl hover:bg-[#FAF8F5] text-[#1A2421]">Layanan Gigi Estetik</a>
          <a href="#dokter" class="px-3.5 py-2 rounded-xl hover:bg-[#FAF8F5] text-[#1A2421]">Dokter Gigi</a>
          <a href="#lokasi" class="px-3.5 py-2 rounded-xl hover:bg-[#FAF8F5] text-[#1A2421]">Lokasi &amp; Jam Buka</a>
          <a href="#faq" class="px-3.5 py-2 rounded-xl hover:bg-[#FAF8F5] text-[#1A2421]">FAQ</a>
        </div>
      </details>
    </div>
  </div>
</header>





