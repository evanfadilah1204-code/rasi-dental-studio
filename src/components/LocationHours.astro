---
const waNumber = "6285891609894";
const waMessage = encodeURIComponent("Halo Rasi Dental Studio, saya mau tanya rute lokasi dan lokasi parkir.");
const waUrl = `https://wa.me/${waNumber}?text=${waMessage}`;
const gmapsUrl = "https://maps.google.com/?q=Jl.+Cihampelas+No.+88+Bandung";
---

<section id="lokasi" class="py-14 sm:py-20 bg-[#FAF8F5] border-b border-[#E5ECE8]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] mb-3">
        Aksesibilitas &amp; Jam Praktek
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1A2421] tracking-tight">
        Lokasi Studio &amp; <span class="italic font-normal text-[#0D4736]">Jam Operasional</span>
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-[#2F443A] font-medium leading-relaxed">
        Terletak strategis di pusat Cihampelas Bandung (Dekat area Cihampelas Walk / Ciwalk).
      </p>
    </div>

    <!-- Location Details Card -->
    <div class="max-w-2xl mx-auto p-7 sm:p-9 rounded-3xl bg-white border border-[#E5ECE8] shadow-2xs space-y-6">
      
      <!-- Address -->
      <div class="space-y-1.5">
        <span class="text-[11px] uppercase font-bold text-[#0D4736] tracking-wider block">Alamat Studio</span>
        <p class="font-serif text-xl sm:text-2xl font-bold text-[#1A2421]">Jl. Cihampelas No. 88</p>
        <p class="text-xs sm:text-sm text-[#2F443A] font-medium leading-relaxed">Kec. Coblong, Kota Bandung, Jawa Barat 40131 (Area Cihampelas Walk / Ciwalk)</p>
      </div>

      <!-- Hours -->
      <div class="pt-5 border-t border-[#F0F4F2] space-y-1.5">
        <span class="text-[11px] uppercase font-bold text-[#0D4736] tracking-wider block">Jam Operasional Studio</span>
        <p class="text-sm font-bold text-[#1A2421]">Selasa – Minggu: 11.00 – 21.00 WIB</p>
        <p class="text-xs text-[#78350F] font-semibold flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Senin: Libur / Tutup Praktek</span>
        </p>
      </div>

      <!-- Facilities -->
      <div class="pt-5 border-t border-[#F0F4F2] space-y-1.5">
        <span class="text-[11px] uppercase font-bold text-[#0D4736] tracking-wider block">Fasilitas Pasien</span>
        <p class="text-xs sm:text-sm text-[#2F443A] font-medium leading-relaxed">Area Parkir Mobil &amp; Motor, AC, Coffee Bar, Free Wi-Fi, &amp; Ruang Tunggu Estetik Tenang.</p>
      </div>

      <!-- Embed Google Maps -->
      <div class="pt-5 border-t border-[#F0F4F2]">
        <div class="rounded-2xl overflow-hidden border border-[#E5ECE8] h-48 sm:h-56">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3960.985223363365!2d107.6019253!3d-6.8923761!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e68e65a0dbf03b1%3A0x7d87b1c3125e9854!2sJl.%20Cihampelas%20No.88%2C%20Bandung!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Peta Lokasi Rasi Dental Studio Cihampelas Bandung"
          ></iframe>
        </div>
      </div>

      <!-- Buttons -->
      <div class="pt-5 border-t border-[#F0F4F2] flex flex-col sm:flex-row gap-3.5">
        <a
          href={gmapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-sumber="lokasi-gmaps-link"
          aria-label="Buka lokasi Rasi Dental Studio di Google Maps"
          class="flex-1 py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold text-center text-[#1A2421] bg-[#FAF8F5] hover:bg-[#F3F0E8] border border-[#D8E0DC] transition-all flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 text-[#0D4736]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Buka lokasi di Google Maps</span>
        </a>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-sumber="lokasi-wa-link"
          aria-label="Tanya Patokan Lokasi dan Parkir Rasi Dental Studio via WhatsApp"
          class="flex-1 py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold text-center text-white bg-[#0D4736] hover:bg-[#072E23] transition-colors flex items-center justify-center gap-2 shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          <span>Tanya Patokan &amp; Parkir</span>
        </a>
      </div>

    </div>

  </div>
</section>



