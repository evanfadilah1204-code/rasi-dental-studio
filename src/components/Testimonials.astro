---
const reviews = [
  {
    name: "Nabila Rizki",
    role: "Mahasiswi ITB Bandung",
    rating: 5,
    treatment: "Pasang Behel Ceramic Aesthetic",
    text: "Awalnya ragu dan takut sakit pas mau pasang behel. Tapi di Rasi Dental Studio suasananya tenang banget kaya kafe di Cihampelas, drg. Kirana ramah dan jelasin estimasi biaya dari A sampai Z tanpa biaya tersembunyi!",
    date: "2 minggu yang lalu"
  },
  {
    name: "Faris Pratama",
    role: "Product Designer / Freelancer",
    rating: 5,
    treatment: "Veneer Direct & Scaling",
    text: "Paling mengapresiasi transparansi harganya. Dokter Bimo informatif banget, nggak ada paksaan tindakan yang tidak perlu. Gigi veneer hasilnya natural banget nggak keliatan tebal buatan.",
    date: "1 bulan yang lalu"
  },
  {
    name: "Clara Salsabila",
    role: "Content Creator Bandung",
    rating: 5,
    treatment: "Teeth Whitening Express",
    text: "Tempatnya bersih banget dan wangi. Proses whitening 45 menit hasilnya kelihatan langsung lebih cerah tanpa rasa ngilu berlebihan. Recomended studio gigi anak muda di Bandung!",
    date: "3 minggu yang lalu"
  }
];
---

<section id="ulasan" class="relative py-14 sm:py-20 bg-[#FAF8F5] border-t border-[#E5ECE8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-[#FEF3C7] text-[#92400E] border border-[#FDE68A] mb-3">
        <svg class="w-3.5 h-3.5 fill-[#D97706] text-[#D97706]" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span>4.9/5 Rating Google Reviews</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1A2421] tracking-tight leading-tight">
        Pengalaman Nyata <span class="italic font-normal text-[#0D4736]">Pasien Rasi Studio</span>
      </h2>
      <p class="mt-3 text-xs sm:text-base text-[#52665E] font-normal leading-relaxed">
        Ulasan langsung dari pasien di Bandung yang mempercayakan perawatan behel &amp; veneer di studio kami.
      </p>
    </div>

    <!-- Reviews Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {reviews.map((rev) => (
        <div class="rounded-3xl p-6 sm:p-8 bg-white border border-[#E5ECE8] flex flex-col justify-between relative shadow-2xs hover:border-[#CBD9D2] transition-all">
          <div>
            <!-- Star Ratings -->
            <div class="flex items-center gap-1 mb-4">
              {[...Array(rev.rating)].map(() => (
                <svg class="w-4 h-4 text-[#D97706] fill-[#D97706]" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Treatment Tag -->
            <span class="inline-block px-3 py-1 rounded-full bg-[#EAF2EE] text-[#0D4736] border border-[#CBD9D2] text-[11px] font-bold mb-4">
              {rev.treatment}
            </span>

            <!-- Review Content -->
            <p class="text-xs sm:text-sm text-[#3D4F46] leading-relaxed mb-6 italic font-normal">
              "{rev.text}"
            </p>
          </div>

          <!-- Reviewer Info Footer -->
          <div class="pt-4 border-t border-[#F0F4F2] flex items-center justify-between">
            <div>
              <h3 class="font-serif text-sm font-bold text-[#1A2421]">{rev.name}</h3>
              <p class="text-[11px] text-[#667A71] font-normal">{rev.role}</p>
            </div>
            <span class="text-[10px] text-[#8AA89B] font-normal">{rev.date}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>


