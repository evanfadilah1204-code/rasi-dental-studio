---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ServicesPricing from '../components/ServicesPricing.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import Doctors from '../components/Doctors.astro';
import LocationHours from '../components/LocationHours.astro';
import FAQ from '../components/FAQ.astro';
import BookingForm from '../components/BookingForm.astro';
import Footer from '../components/Footer.astro';
import FloatingWA from '../components/FloatingWA.astro';
---

<Layout 
  title="Rasi Dental Studio | Klinik Gigi Spesialis Behel & Veneer Bandung"
  description="Klinik gigi modern Rasi Dental Studio di Jl. Cihampelas No. 88 Bandung. Spesialis behel & veneer untuk anak muda dengan transparansi biaya 100% tanpa biaya tersembunyi."
>
  <Navbar />
  
  <main id="main-content">
    <!-- Section 1: Hero -->
    <Hero />

    <!-- Section 2: Harga -->
    <ServicesPricing />

    <!-- Section 3: Layanan -->
    <ServicesOverview />

    <!-- Section 4: Dokter -->
    <Doctors />

    <!-- Section 5: Lokasi -->
    <LocationHours />

    <!-- Section 6: FAQ -->
    <FAQ />

    <!-- Section 7: CTA & Reservasi -->
    <BookingForm />
  </main>

  <Footer />
  <FloatingWA />
</Layout>

